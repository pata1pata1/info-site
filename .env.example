# Supabase（会員登録・情報提供コメント）
# Supabase ダッシュボード > Project Settings > API Keys から取得してください。
# 未設定の場合、サイトの閲覧はできますが会員登録・ログイン・コメント投稿は無効になります。
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key（旧 anon key でも可）。サービスロールキー（secret key）は絶対に設定しないでください。
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 確認メールのリンク先に使うサイトの URL（例：https://example.com）。未設定時はリクエストの Origin を使用
NEXT_PUBLIC_SITE_URL=
